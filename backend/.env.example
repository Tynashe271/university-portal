# Copy this file to .env (same folder as manage.py) and fill in real values
# to send real email for admission confirmations, password resets, etc.
# .env is gitignored — never commit real credentials.
#
# Leaving EMAIL_HOST_USER/EMAIL_HOST_PASSWORD unset falls back to printing
# emails to the console instead of sending them, so the app still runs fine
# without this file.

# --- Gmail example ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
#    (use that 16-character app password below — NOT your normal Gmail password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Anyschool High School <your-address@gmail.com>

# Where the frontend is served — used to build the "track your application"
# link in the admission confirmation email.
FRONTEND_URL=http://localhost:5500

# --- Production settings (all optional locally — see config/settings.py
# for what each one defaults to when unset; render.yaml sets these for the
# actual Render deployment, so you don't need to set them by hand there) ---
# SECRET_KEY=
# DEBUG=false
# ALLOWED_HOSTS=your-backend-domain.example.com
# CORS_EXTRA_ORIGINS=https://your-frontend-domain.example.com
# DATABASE_URL=postgres://user:password@host:5432/dbname
